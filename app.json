{
  "expo": {
    "name": "StyleMate",
    "slug": "stylemate",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "stylemate",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "StyleMate needs access to your photos so you can add pictures of your clothes.",
          "cameraPermission": "StyleMate uses your camera so you can take a picture of a clothing item.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F2EC"
      }
    }
  }
}
